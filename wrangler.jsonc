{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "starunico",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-18",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Client-side routes (/about, /pricing, ...) fall back to index.html.
    "not_found_handling": "single-page-application",
    // Everything else is served straight from the asset layer; only the API
    // wakes the Worker, so static requests cost nothing. "/api" is listed
    // separately because "/api/*" does not match the bare path.
    "run_worker_first": ["/api", "/api/*"]
  },

  "observability": {
    "enabled": true
  },

  "vars": {
    // Comma-separated allow-list, or "*" for any origin.
    "ALLOWED_ORIGINS": "*"
  }

  // Optional: forward contact submissions somewhere real.
  // Set it as a secret rather than a var:
  //   npx wrangler secret put CONTACT_WEBHOOK_URL
}
