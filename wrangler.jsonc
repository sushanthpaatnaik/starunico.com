{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Cloudflare resource id, NOT the public domain — the site is served at
  // starunicocapital.com. This must keep matching the Worker's name in the
  // Cloudflare dashboard; renaming it here alone would deploy to a different
  // Worker that has no custom domain attached.
  "name": "starunico-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-18",

  // Runs before the Worker is bundled and the assets are uploaded, so a bare
  // `npx wrangler deploy` produces dist/ itself. Cloudflare Workers Builds can
  // then deploy with its default command and no build step configured.
  "build": {
    "command": "npm run build"
  },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // "none" rather than "single-page-application": the asset layer must stop at
    // real files so unmatched paths reach the Worker, which serves the
    // single-page document itself and can answer 404 for a path the router does
    // not know. With the SPA setting the asset layer answered 200 for anything.
    "not_found_handling": "none",
    // Everything else is served straight from the asset layer; only the API
    // wakes the Worker, so static requests cost nothing. "/api" is listed
    // separately because "/api/*" does not match the bare path.
    "run_worker_first": ["/api", "/api/*"]
  },

  // Public site: https://starunicocapital.com
  // Also reachable at https://starunico-com.<account-subdomain>.workers.dev
  "workers_dev": true,
  // Per-branch preview URLs for non-production branch builds.
  "preview_urls": true,

  "observability": {
    "enabled": true
  },

  "vars": {
    // Comma-separated allow-list, or "*" for any origin.
    "ALLOWED_ORIGINS": "*"
  }

  // Optional: forward contact submissions somewhere real.
  // Set it as a secret rather than a var:
  //   npx wrangler secret put CONTACT_WEBHOOK_URL
}
